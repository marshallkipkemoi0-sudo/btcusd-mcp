
import json
import os
import urllib.parse
import urllib.request
from datetime import datetime, timedelta, timezone

from mcp.server.fastmcp import FastMCP

app = FastMCP(
    "BTCUSD Market Learning",
    host="0.0.0.0",
    port=int(os.environ.get("PORT", "8000")),
)

COINBASE_URL = "https://api.exchange.coinbase.com"
GRANULARITIES = {
    "1m": 60,
    "5m": 300,
    "15m": 900,
    "1h": 3600,
    "6h": 21600,
    "1d": 86400,
}


@app.tool()
def get_btcusd_candles(
    timeframe: str = "15m",
    limit: int = 100,
) -> dict:
    """Fetch historical BTC-USD candles from Coinbase.
    Read-only market data; this tool cannot place trades.
    """
    if timeframe not in GRANULARITIES:
        return {
            "error": "Unsupported timeframe",
            "allowed": list(GRANULARITIES),
        }

    if not 1 <= limit <= 200:
        return {"error": "limit must be between 1 and 200"}

    now = datetime.now(timezone.utc)
    seconds = GRANULARITIES[timeframe]
    start = now - timedelta(seconds=seconds * limit)

    params = urllib.parse.urlencode({
        "granularity": seconds,
        "start": start.isoformat(),
        "end": now.isoformat(),
    })
    url = f"{COINBASE_URL}/products/BTC-USD/candles?{params}"

    request = urllib.request.Request(
        url,
        headers={
            "User-Agent": "BTCUSD-Market-Learning/0.1",
            "Accept": "application/json",
        },
    )

    try:
        with urllib.request.urlopen(request, timeout=15) as response:
            candles = json.loads(response.read().decode("utf-8"))
    except Exception as exc:
        return {
            "error": "Market-data request failed",
            "details": str(exc),
            "provider": "Coinbase Exchange",
        }

    if not isinstance(candles, list):
        return {
            "error": "Unexpected response from market-data provider",
            "response": candles,
        }

    # Coinbase format: [time, low, high, open, close, volume]
    candles.sort(key=lambda candle: candle[0])

    result = []
    for candle in candles[-limit:]:
        if not isinstance(candle, list) or len(candle) < 6:
            continue

        timestamp, low, high, open_price, close, volume = candle

        result.append({
            "time_utc": datetime.fromtimestamp(
                timestamp, tz=timezone.utc
            ).isoformat(),
            "open": open_price,
            "high": high,
            "low": low,
            "close": close,
            "volume": volume,
        })

    return {
        "provider": "Coinbase Exchange",
        "symbol": "BTC-USD",
        "timeframe": timeframe,
        "count": len(result),
        "candles": result,
        "note": (
            "This is Coinbase BTC-USD data. It may differ from "
            "your broker's BTCUSD feed on TradingView."
        ),
    }


if __name__ == "__main__":
    app.run(transport="streamable-http")
